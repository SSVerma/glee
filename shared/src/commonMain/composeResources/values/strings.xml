    <string name="gemma_4_e2b_name">Gemma 4 E2B</string>
    <string name="gemma_4_e2b_desc">State-of-the-art reasoning for compact devices. Best for coding, high-fidelity chat, and technical logic.</string>
    <string name="gemma_4_e2b_best_for">Coding assistance, technical writing, complex reasoning.</string>
    <string name="gemma_4_e2b_resource_usage">Requires ~4GB RAM. ~2.6GB storage.</string>
    <string name="gemma_4_e4b_name">Gemma 4 E4B</string>
    <string name="gemma_4_e4b_desc">Maximum capacity for edge intelligence. Use for deep analysis where accuracy is the top priority.</string>
    <string name="gemma_4_e4b_best_for">Mathematical proofs, deep technical research, high-precision logic.</string>
    <string name="gemma_4_e4b_resource_usage">Requires ~8GB RAM. ~3.7GB storage.</string>
    <string name="gemma_3n_e2b_name">Gemma 3n E2B</string>
    <string name="gemma_3n_e2b_desc">High-speed multimodal intelligence. Perfect for quick visual analysis and ultra-fast chatting.</string>
    <string name="gemma_3n_e2b_best_for">Quick queries, simple visual identification, low-power chatting.</string>
    <string name="gemma_3n_e2b_resource_usage">Requires ~4GB RAM. ~3.6GB storage.</string>
